{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 check.py >&2 || exit 2",
            "timeout": 30,
            "statusMessage": "Checking the docs against the site"
          }
        ]
      }
    ]
  }
}
